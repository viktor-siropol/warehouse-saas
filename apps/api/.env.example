DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

PORT="3001"

JWT_ACCESS_SECRET="replace-with-a-random-secret"

JWT_ACCESS_TTL_SECONDS="900"

JWT_ISSUER="warehouse-api"

JWT_AUDIENCE="warehouse-web"

REFRESH_SESSION_TTL_DAYS="30"
# Local development/test seed only.
# Keep disabled by default.
# Never enable this in a public or production deployment.
DEV_SEED_ENABLED=false
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LOCK_TIMEOUT_MS=60000