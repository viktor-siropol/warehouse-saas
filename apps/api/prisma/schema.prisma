generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  WORKER
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RESERVED
  RESERVED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  warehouses     Warehouse[]
  categories     Category[]
  products       Product[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  customers      Customer[]
  salesOrders    SalesOrder[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships              Membership[]
  stockMovements           StockMovement[]
  refreshSessions          RefreshSession[]
  purchaseOrdersCreated    PurchaseOrder[]    @relation("PurchaseOrderCreatedBy")
  purchaseReceiptsReceived PurchaseReceipt[]  @relation("PurchaseReceiptReceivedBy")
  salesOrdersCreated       SalesOrder[]       @relation("SalesOrderCreatedBy")
  salesFulfillmentsCreated SalesFulfillment[] @relation("SalesFulfillmentFulfilledBy")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole @default(WORKER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Warehouse {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventories       Inventory[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  purchaseReceipts  PurchaseReceipt[]
  salesOrders       SalesOrder[]
  salesFulfillments SalesFulfillment[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  categoryId     String   @db.Uuid
  sku            String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventories        Inventory[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, categoryId])
  @@index([organizationId, isActive])
}

model Inventory {
  warehouseId      String   @db.Uuid
  productId        String   @db.Uuid
  quantity         Decimal  @default(0) @db.Decimal(18, 3)
  reservedQuantity Decimal  @default(0) @db.Decimal(18, 3)
  reorderPoint     Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt        DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([warehouseId, productId])
  @@index([productId])
}

model StockMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  operationId        String?           @db.Uuid
  productId          String            @db.Uuid
  purchaseReceiptId  String?           @db.Uuid
  warehouseId        String            @db.Uuid
  createdById        String?           @db.Uuid
  salesFulfillmentId String?           @db.Uuid
  type               StockMovementType
  delta              Decimal           @db.Decimal(18, 3)
  note               String?
  createdAt          DateTime          @default(now())

  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseReceipt  PurchaseReceipt?  @relation(fields: [purchaseReceiptId], references: [id], onDelete: SetNull)
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy        User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  salesFulfillment SalesFulfillment? @relation(fields: [salesFulfillmentId], references: [id], onDelete: SetNull)

  @@index([operationId])
  @@index([productId, createdAt(sort: Desc)])
  @@index([warehouseId, createdAt(sort: Desc)])
  @@index([createdById])
  @@index([purchaseReceiptId])
  @@index([salesFulfillmentId])
}

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  supplierId     String              @db.Uuid
  warehouseId    String              @db.Uuid
  createdById    String?             @db.Uuid
  number         String
  status         PurchaseOrderStatus @default(DRAFT)
  currency       String              @db.VarChar(3)
  note           String?
  submittedAt    DateTime?
  receivedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  createdBy User? @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([createdById])
}

model PurchaseOrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseOrderId  String   @db.Uuid
  productId        String   @db.Uuid
  orderedQuantity  Decimal  @db.Decimal(18, 3)
  receivedQuantity Decimal  @default(0) @db.Decimal(18, 3)
  unitCost         Decimal  @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  receiptItems PurchaseReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

model PurchaseReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @db.Uuid
  warehouseId     String   @db.Uuid
  receivedById    String?  @db.Uuid
  note            String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  receivedBy User? @relation("PurchaseReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  items          PurchaseReceiptItem[]
  stockMovements StockMovement[]

  @@index([purchaseOrderId, createdAt])
  @@index([warehouseId])
  @@index([receivedById])
}

model PurchaseReceiptItem {
  id                  String  @id @default(uuid()) @db.Uuid
  receiptId           String  @db.Uuid
  purchaseOrderItemId String  @db.Uuid
  quantity            Decimal @db.Decimal(18, 3)

  receipt           PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  @@unique([receiptId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
}

model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  code            String
  name            String
  contactName     String?
  email           String?
  phone           String?
  shippingAddress String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesOrders  SalesOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model SalesOrder {
  id                      String           @id @default(uuid()) @db.Uuid
  organizationId          String           @db.Uuid
  customerId              String           @db.Uuid
  warehouseId             String           @db.Uuid
  createdById             String?          @db.Uuid
  number                  String
  status                  SalesOrderStatus @default(DRAFT)
  currency                String           @db.VarChar(3)
  note                    String?
  customerNameSnapshot    String
  shippingAddressSnapshot String?
  confirmedAt             DateTime?
  fulfilledAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items        SalesOrderItem[]
  fulfillments SalesFulfillment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([warehouseId, status])
  @@index([createdById])
}

model SalesOrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  salesOrderId      String   @db.Uuid
  productId         String   @db.Uuid
  orderedQuantity   Decimal  @db.Decimal(18, 3)
  reservedQuantity  Decimal  @default(0) @db.Decimal(18, 3)
  fulfilledQuantity Decimal  @default(0) @db.Decimal(18, 3)
  unitPrice         Decimal  @db.Decimal(18, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  salesOrder       SalesOrder             @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  fulfillmentItems SalesFulfillmentItem[]

  @@unique([salesOrderId, productId])
  @@index([productId])
}

model SalesFulfillment {
  id            String   @id @default(uuid()) @db.Uuid
  salesOrderId  String   @db.Uuid
  warehouseId   String   @db.Uuid
  fulfilledById String?  @db.Uuid
  note          String?
  createdAt     DateTime @default(now())

  salesOrder  SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  fulfilledBy User?      @relation("SalesFulfillmentFulfilledBy", fields: [fulfilledById], references: [id], onDelete: SetNull)

  items          SalesFulfillmentItem[]
  stockMovements StockMovement[]

  @@index([salesOrderId, createdAt])
  @@index([warehouseId])
  @@index([fulfilledById])
}

model SalesFulfillmentItem {
  id               String  @id @default(uuid()) @db.Uuid
  fulfillmentId    String  @db.Uuid
  salesOrderItemId String  @db.Uuid
  quantity         Decimal @db.Decimal(18, 3)

  fulfillment    SalesFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem   @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)

  @@unique([fulfillmentId, salesOrderItemId])
  @@index([salesOrderItemId])
}
